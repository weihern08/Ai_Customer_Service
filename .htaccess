# NovaServe Support - Apache configuration (XAMPP / cPanel)
Options -Indexes
DirectoryIndex index.php

# Block direct access to non-public file types anywhere in the project
<FilesMatch "\.(sql|log|lock|md|ini|sh|bak|dist|env|gitkeep)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Microphone is needed for voice input on the chat page
    Header always set Permissions-Policy "microphone=(self), camera=(), geolocation=()"
</IfModule>
